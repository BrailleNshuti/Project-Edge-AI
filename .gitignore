# Python / environment
.venv/
__pycache__/
*.pyc

# Downloaded datasets (large, regenerable via training/prepare_*.py)
data/

# Training logs (large, reference only, not needed to understand the code)
training/logs/

# Real personal photos of real people -- not for public distribution.
# The code that processes them is included; the photos themselves are not.
# Wildcards used deliberately: the "20 pics for..." folder name contains a
# garbled/corrupted character on disk that doesn't match as literal text.
evaluation/photos/
evaluation/photoszip.zip
20 pics for*/
current/
new pcs/
pictures/

# Claude Code session/tooling files, not part of the submitted project
.claude/

# Word lock/temp files
~$*.docx
~WRL*.tmp

# Machine-specific Android SDK path, not portable to another machine
android_app/local.properties

# Personal dev-process working notes, not part of the submission -- kept locally only
NEXT_STEPS.md

# Submitted directly via myCampus, not the public repo
Project_Report.docx

# Regenerable model-conversion bridges (see training/resave_legacy_keras.py --help) and
# rejected experimental model versions (see README's age-bias Design note for why they
# were rejected) -- not needed to reproduce or run anything, only the canonical .keras
# files and the already-converted web_app/ and android_app/ artifacts are.
training/saved_models/*_legacy.h5
training/saved_models/*_weights.npz
training/saved_models/age_gender_model_V2_WITH_BEARD_AUG.keras
