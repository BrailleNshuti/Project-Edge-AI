<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:text="Pick a photo with a face, then run N inference passes to measure average on-device latency. Use this number for the 'edge' column of your CPU/GPU/edge performance table." />

    <Button
        android:id="@+id/btnPickForBenchmark"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Pick Photo" />

    <Button
        android:id="@+id/btnRunBenchmark"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:enabled="false"
        android:text="Run Benchmark (50 passes)" />

    <TextView
        android:id="@+id/benchmarkResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="monospace"
        android:textSize="14sp" />
</LinearLayout>
